<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sky blue of the artwork, so launching never flashes white. -->
    <color name="sky">#FF1E78E4</color>

    <style name="Theme.ColorPop" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
